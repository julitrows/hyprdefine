#!/bin/bash

# Manage omarchy-dict's dictionaries. They live in ~/.local/share/omarchy-dict
# and are served by a user-level dictd (omarchy-dict.service), so none of this
# needs sudo.
#
# Usage: dictionaries install [--notify] <code>...  add languages
#        dictionaries remove <code>...              remove languages
#        dictionaries update                        rebuild every language
#        dictionaries decline <code>...             stop offering them
#        dictionaries menu                          manage them with gum
#
# Codes come from lib/languages. Installing a language downloads its
# reader.dict dictionary (except English, which uses GCIDE when the dict-gcide
# package is installed) and the FreeDict translations between it and every
# other installed language.

set -eEuo pipefail

LIB="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")"
DATA="$HOME/.local/share/omarchy-dict"
CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}/omarchy-dict"
DICTS="$DATA/dictionaries"
READER_URL=https://www.reader-dict.com/file
FREEDICT_URL=https://freedict.org/freedict-database.json
GCIDE=/usr/share/dictd/gcide
SERVICE=omarchy-dict.service

LANGUAGES=()
declare -A FREEDICT NAMES
while read -r code freedict name; do
  [[ -z $code || $code == \#* ]] && continue
  LANGUAGES+=("$code")
  FREEDICT[$code]=$freedict
  NAMES[$code]=$name
done <"$LIB/languages"

mkdir -p "$DICTS" "$CONFIG"
touch "$CONFIG/languages" "$CONFIG/declined"

# Codes listed in a state file, one line of space-separated codes.
codes() {
  xargs <"$CONFIG/$1"
}

has() {
  [[ " $(codes languages) " == *" $1 "* ]]
}

# Save codes to a state file in lib/languages order, without duplicates.
save() {
  local file=$1 code
  shift
  for code in "${LANGUAGES[@]}"; do
    [[ " $* " != *" $code "* ]] || printf '%s ' "$code"
  done | xargs >"$CONFIG/$file"
}

check_codes() {
  local code
  for code; do
    if [[ -z ${NAMES[$code]:-} ]]; then
      echo "Unknown language \"$code\". Choose from: ${LANGUAGES[*]}." >&2
      exit 2
    fi
  done
}

names() {
  local code
  for code; do printf '%s, ' "${NAMES[$code]}"; done | sed 's/, $//'
}

# Download and build reader.dict's dictionary for a language as <code>-<code>.
build_language() {
  local code=$1 dir
  dir=$(mktemp -d)

  echo "Downloading the ${NAMES[$code]} dictionary..."
  curl -fL --progress-bar -o "$dir/download.zip" "$READER_URL/$code/dictorg-$code-$code-noetym.zip"

  echo "Building the ${NAMES[$code]} dictionary..."
  python3 -I "$LIB/reader-dict.py" "$dir/download.zip" |
    dictfmt -f --utf8 --quiet --columns 0 \
      -u https://www.reader-dict.com -s "${NAMES[$code]} (Wiktionary, reader.dict)" \
      "$dir/$code-$code"
  dictzip "$dir/$code-$code.dict"
  mv "$dir/$code-$code.dict.dz" "$dir/$code-$code.index" "$DICTS/"
  rm -rf "$dir"
}

# FreeDict's catalogue, refreshed when it's a week old or on request.
catalogue() {
  local file="$DATA/freedict.json"
  if [[ ${1:-} == --refresh || ! -s $file || -n $(find "$file" -mtime +7) ]]; then
    curl -fsSL -o "$file.new" "$FREEDICT_URL" && mv "$file.new" "$file"
  fi
  echo "$file"
}

# Download the FreeDict translations between installed languages that aren't
# there yet (or all of them with --refresh), and delete the ones that no
# longer have both languages installed.
sync_translations() {
  local installed from to pair wanted=() missing=() name url checksum dir file
  read -r -a installed <<<"$(codes languages)"

  for from in "${installed[@]}"; do
    for to in "${installed[@]}"; do
      [[ $from == "$to" ]] && continue
      pair="${FREEDICT[$from]}-${FREEDICT[$to]}"
      wanted+=("$pair")
      [[ ${1:-} != --refresh && -f $DICTS/$pair.index ]] || missing+=("$pair")
    done
  done

  for file in "$DICTS"/*.index; do
    [[ -e $file ]] || continue
    pair=$(basename "$file" .index)
    # Skip reader.dict's dictionaries, named <code>-<code>.
    [[ $pair == "${pair%%-*}-${pair%%-*}" ]] && continue
    [[ " ${wanted[*]} " == *" $pair "* ]] || rm -f "$DICTS/$pair.index" "$DICTS/$pair.dict.dz"
  done

  (( ${#missing[@]} )) || return 0
  python3 -I "$LIB/freedict.py" "$(catalogue "$@")" "${missing[@]}" |
    while read -r name url checksum; do
      echo "Downloading the $name translations..."
      dir=$(mktemp -d)
      if ! curl -fsSL -o "$dir/release.tar.xz" "$url"; then
        echo "Couldn't download the $name translations; define will use dict.org." >&2
        rm -rf "$dir"
        continue
      fi
      if ! sha512sum --quiet -c <<<"$checksum  $dir/release.tar.xz"; then
        echo "The $name download doesn't match its checksum; skipping it." >&2
        rm -rf "$dir"
        continue
      fi
      tar -xJf "$dir/release.tar.xz" -C "$dir"
      mv "$dir/$name/$name.dict.dz" "$dir/$name/$name.index" "$DICTS/"
      rm -rf "$dir"
    done
}

# Point dictd at every installed dictionary and restart it, or stop it when
# there's nothing to serve, because dictd won't start without a database.
serve() {
  local file conf="$DATA/dictd.conf"

  {
    if has en && [[ -f $GCIDE.index ]]; then
      printf 'database gcide { data "%s.dict.dz" index "%s.index" }\n' "$GCIDE" "$GCIDE"
    fi
    for file in "$DICTS"/*.index; do
      [[ -e $file ]] || continue
      printf 'database %s { data "%s" index "%s" }\n' \
        "$(basename "$file" .index)" "${file%.index}.dict.dz" "$file"
    done
  } >"$conf"

  if [[ -s $conf ]]; then
    systemctl --user restart "$SERVICE"
  else
    systemctl --user stop "$SERVICE"
  fi
}

install() {
  local notify=false code installed
  if [[ ${1:-} == --notify ]]; then
    notify=true
    shift
  fi
  check_codes "$@"
  if [[ $notify == true ]]; then
    failed="Couldn't install $(names "$@"). See $DATA/install.log."
    trap 'notify-send -u critical Dictionary "$failed" || true' ERR
  fi

  for code; do
    if [[ $code != en && ! -f $DICTS/$code-$code.index ]]; then
      build_language "$code"
    fi
  done
  read -r -a installed <<<"$(codes languages)"
  save languages "${installed[@]}" "$@"
  sync_translations
  serve

  echo "Installed $(names "$@")."
  [[ $notify == false ]] || notify-send "Dictionary" "$(names "$@") installed for offline lookups." || true
}

remove() {
  local code installed=()
  check_codes "$@"

  for code in $(codes languages); do
    [[ " $* " == *" $code "* ]] || installed+=("$code")
  done
  save languages "${installed[@]}"
  for code; do
    rm -f "$DICTS/$code-$code.dict.dz" "$DICTS/$code-$code.index"
  done
  sync_translations
  serve
  echo "Removed $(names "$@")."
}

update() {
  local code
  for code in $(codes languages); do
    [[ $code == en ]] || build_language "$code"
  done
  sync_translations --refresh
  serve
}

decline() {
  check_codes "$@"
  # shellcheck disable=SC2046
  save declined $(codes declined) "$@"
}

# Pick languages with gum from the given codes, and print the chosen codes.
pick() {
  local header=$1 code options=()
  shift
  for code; do options+=("${NAMES[$code]} ($code)"); done
  gum choose --no-limit --height 20 --header "$header" "${options[@]}" |
    sed -n 's/.*(\([a-z]*\))$/\1/p'
}

menu() {
  local action installed available picked

  while true; do
    read -r -a installed <<<"$(codes languages)"
    available=()
    for code in "${LANGUAGES[@]}"; do
      has "$code" || available+=("$code")
    done

    clear
    echo "Installed: $( (( ${#installed[@]} )) && names "${installed[@]}" || echo none) ($(du -sh "$DICTS" | cut -f1))"
    echo "Not offered again: $( [[ -s $CONFIG/declined ]] && names $(codes declined) || echo none)"
    echo
    action=$(gum choose --header "Dictionary languages" \
      "Add languages" "Remove languages" "Update all" "Offer every language again" "Done") || return 0

    case $action in
      "Add languages")
        picked=$(pick "Languages to add" "${available[@]}") || continue
        [[ -z $picked ]] || "$0" install $picked || true
        ;;
      "Remove languages")
        (( ${#installed[@]} )) || continue
        picked=$(pick "Languages to remove" "${installed[@]}") || continue
        [[ -z $picked ]] || "$0" remove $picked || true
        ;;
      "Update all") "$0" update || true ;;
      "Offer every language again") : >"$CONFIG/declined" ;;
      *) return 0 ;;
    esac
    gum input --placeholder "Press Enter to continue" >/dev/null || true
  done
}

command=${1:-}
shift || true
mkdir -p "$DATA"
exec 9>"$DATA/lock"

case $command in
  install | remove | update)
    # One change at a time, so a background install and the menu don't clash.
    flock 9
    "$command" "$@"
    ;;
  decline) decline "$@" ;;
  menu) menu ;;
  *)
    sed -n '/^# Usage/,/^$/s/^# \{0,1\}//p' "$0" >&2
    exit 2
    ;;
esac
