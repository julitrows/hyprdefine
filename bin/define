#!/bin/bash

# Look a word up in every language that has it. Pass a word to look it up
# once, or run with no arguments to keep prompting until an empty word is
# entered.
#
# Usage: define [--<code>] [--selection] [--languages] [word...]
#   --<code>     search only that language, such as --es or --fr
#   --selection  look up the selected text and quit, or prompt if nothing is
#                selected
#   --languages  add, remove or update the installed languages
#
# Installed languages (listed in ~/.config/omarchy-dict/languages) are searched
# on the local dictionary server, with their translations to each other. Every
# other language comes from English Wiktionary, as English meanings. When the
# word is in an installed language, only those are shown in full and the rest
# are listed as "also in"; otherwise every language that has it is shown. In
# the popup, define then offers to install the languages it showed.

LIB="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../lib"
CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}/omarchy-dict"
LOG="$HOME/.local/share/omarchy-dict/install.log"
# lib/dictionaries' user-level dictd, from systemd/omarchy-dict.service.
PORT=2629

LANGUAGES=()
declare -A FREEDICT NAME
while read -r code freedict name; do
  [[ -z $code || $code == \#* ]] && continue
  LANGUAGES+=("$code")
  FREEDICT[$code]=$freedict
  NAME[$code]=$name
done <"$LIB/languages"

installed=()
read -r -a installed 2>/dev/null <"$CONFIG/languages"
declined=()
read -r -a declined 2>/dev/null <"$CONFIG/declined"

contains() {
  local item=$1
  shift
  [[ " $* " == *" $item "* ]]
}

only=""
selection=false
while [[ ${1:-} == --* ]]; do
  case $1 in
    --selection) selection=true ;;
    --languages) exec "$LIB/dictionaries" menu ;;
    *)
      if [[ -z ${NAME[${1#--}]:-} ]]; then
        echo "define: unknown option $1" >&2
        exit 2
      fi
      only=${1#--}
      ;;
  esac
  shift
done

# A language's databases, as "local remote" pairs: the local dictd server is
# used when it has the database, and dict.org when it doesn't. A "-" means
# there is no such database on that side. Translations go to every other
# installed language.
databases_for() {
  local other from=${FREEDICT[$1]} to

  if [[ $1 == en ]]; then
    printf '%s\n' "gcide gcide" "- wn" "- moby-thesaurus"
  else
    echo "$1-$1 -"
  fi
  contains "$1" "${installed[@]}" || return 0
  for other in "${installed[@]}"; do
    to=${FREEDICT[$other]:-}
    [[ $other == "$1" || -z $to ]] || echo "$from-$to fd-$from-$to"
  done
}

# Print a database's definitions without dict's "N definitions found" banner.
query() {
  local server=(-h dict.org)
  [[ $1 == local ]] && server=(-h localhost -p "$PORT")
  dict "${server[@]}" -d "$2" -- "$3" 2>/dev/null | sed '1{/definitions\? found$/{N;d}}'
  return "${PIPESTATUS[0]}"
}

search() {
  local local_db remote_db status=39
  read -r local_db remote_db <<<"$1"

  if [[ $local_db != - ]]; then
    query local "$local_db" "$2"
    status=$?
  fi

  # 0 is a match and 20/21 a miss; anything else means the local server or
  # database isn't there.
  if (( status != 0 && status != 20 && status != 21 )) && [[ $remote_db != - ]]; then
    query remote "$remote_db" "$2"
  fi
}

# Search for a word and write what to show to $work/out. Sets offer to the
# languages shown in full that aren't installed or declined.
collect() {
  local word=$1 code database file i=0 found=() shown=() also=() yours=()
  work=$(mktemp -d)
  mkdir "$work/wiki"

  # Installed languages' dictionaries, plus English's online ones, which
  # replace Wiktionary's English meanings whenever English is shown.
  for code in "${LANGUAGES[@]}"; do
    [[ -z $only || $code == "$only" ]] || continue
    [[ $code == en ]] || contains "$code" "${installed[@]}" || continue
    mkdir "$work/$code"
    while read -r database; do
      printf -v file '%s/%s/%03d' "$work" "$code" "$i"
      i=$((i + 1))
      search "$database" "$word" >"$file" </dev/null &
    done < <(databases_for "$code")
  done
  python3 -I "$LIB/wiktionary.py" "$word" "$LIB/languages" "$work/wiki" 2>/dev/null &
  wait

  for code in "${LANGUAGES[@]}"; do
    [[ -z $only || $code == "$only" ]] || continue
    if [[ -d $work/$code ]]; then
      for file in "$work/$code"/*; do
        [[ -s $file ]] && cat "$file" && echo
      done >"$work/$code.out"
    fi
    # English Wiktionary's own English entries are mostly names when GCIDE and
    # WordNet don't have a word, so English only counts through those.
    if [[ ! -s $work/$code.out ]]; then
      [[ $code != en ]] && mv "$work/wiki/$code" "$work/$code.out" 2>/dev/null || continue
    fi
    found+=("$code")
    ! contains "$code" "${installed[@]}" || yours+=("$code")
  done

  if [[ -n $only || ${#yours[@]} -eq 0 ]]; then
    shown=("${found[@]}")
  else
    shown=("${yours[@]}")
    for code in "${found[@]}"; do
      contains "$code" "${yours[@]}" || also+=("${NAME[$code]}")
    done
  fi

  offer=()
  for code in "${shown[@]}"; do
    contains "$code" "${installed[@]}" "${declined[@]}" || offer+=("$code")
  done

  for code in "${shown[@]}"; do
    if (( ${#shown[@]} > 1 )); then
      printf '%s\n%s\n\n' "${NAME[$code]}" "${NAME[$code]//?/═}"
    fi
    cat "$work/$code.out"
  done >"$work/out"
  if (( ${#also[@]} )); then
    printf 'Also in: %s\n' "$(IFS=,; echo "${also[*]}" | sed 's/,/, /g')" >>"$work/out"
  fi
}

# Show a word's definitions in less.
lookup() {
  local found suggestions

  collect "$1"
  found=$(cat "$work/out")
  rm -r "$work"
  if [[ -z $found ]]; then
    found="No definitions found for \"$1\""
    if suggestions=$(dict -h localhost -p "$PORT" -m -s lev -- "$1" 2>/dev/null ||
      dict -h dict.org -d wn -m -s lev -- "$1" 2>/dev/null); then
      found+=$'\n\nPerhaps you mean:\n'"$suggestions"
    fi
  fi

  # The leading "s" picks less's short prompt, and the escapes keep prompt
  # syntax such as "?" and "." in the word literal.
  less "${pager[@]}" --prompt="s$(sed 's/[?%\\:.]/\\&/g' <<<"$1") (q to $leave)" <<<"$found"
}

# Offer to install the languages in $offer. Picked ones install in the
# background; the rest aren't offered again.
offer_install() {
  local code picked="" names=() install=() decline=()
  (( ${#offer[@]} )) && [[ -t 0 && -z ${OMARCHY_DICT_NO_OFFER:-} ]] || return 0

  for code in "${offer[@]}"; do names+=("${NAME[$code]}"); done
  clear
  if command -v gum >/dev/null; then
    # Esc asks again next time.
    picked=$(gum choose --no-limit --header "Install for offline lookups and definitions in their own language?
x picks, Enter confirms. Languages you don't pick won't be offered again." "${names[@]}") || return 0
  else
    read -rp "Install ${names[*]} for offline lookups? [y/N] " picked
    [[ $picked == [yY]* ]] && picked=$(printf '%s\n' "${names[@]}") || picked=""
  fi

  for code in "${offer[@]}"; do
    if grep -qxF -e "${NAME[$code]}" <<<"$picked"; then install+=("$code"); else decline+=("$code"); fi
  done
  (( ${#decline[@]} )) && "$LIB/dictionaries" decline "${decline[@]}"
  declined+=("${decline[@]}")
  if (( ${#install[@]} )); then
    mkdir -p "$(dirname "$LOG")"
    setsid -f "$LIB/dictionaries" install --notify "${install[@]}" >>"$LOG" 2>&1 </dev/null
    declined+=("${install[@]}")
    echo "Installing in the background. A notification will say when it's ready."
    sleep 2
  fi
}

# The primary selection's first line, without surrounding punctuation or space.
selected() {
  wl-paste --primary --no-newline 2>/dev/null | head -n1 |
    sed 's/^[^[:alnum:]]*//; s/[^[:alnum:]]*$//'
}

ask() {
  local prompt="Define: " placeholder="Word to define (Enter on empty to quit, :languages to manage)"

  if command -v gum >/dev/null; then
    gum input --placeholder "$placeholder" --prompt "$prompt"
  else
    read -rp "$prompt" word && echo "$word"
  fi
}

if (( $# > 0 )); then
  pager=(--quit-if-one-screen)
  leave=quit
  lookup "$*"
  exit
fi

# Keep the pager open even for short entries, or the prompt's clear wipes them,
# and clear the screen so short entries are drawn from the top rather than
# scrolled up from the bottom, without "~" on the empty lines below them.
pager=(--clear-screen --tilde)
leave="go back"

if [[ $selection == true ]] && word=$(selected) && [[ -n $word ]]; then
  leave=close
  lookup "$word"
  offer_install
  exit
fi

while word=$(ask) && [[ -n $word ]]; do
  clear
  if [[ $word == :languages ]]; then
    "$LIB/dictionaries" menu
    read -r -a installed 2>/dev/null <"$CONFIG/languages"
    read -r -a declined 2>/dev/null <"$CONFIG/declined"
  else
    lookup "$word"
    offer_install
  fi
  clear
done
