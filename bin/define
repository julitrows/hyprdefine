#!/bin/bash

# Look up words with dict(1) in every installed language at once. Pass a word to
# look it up once, or run with no arguments to keep prompting until an empty
# word is entered.
#
# Usage: define [--<code>] [--selection] [word...]
#   --<code>     search only that language, such as --es or --fr
#   --selection  look up the selected text and quit, or prompt if nothing is
#                selected
#
# The installed languages are listed in ~/.config/omarchy-dict/languages, which
# install.sh writes; the codes and names come from lib/languages.

LIB="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../lib"

declare -A FREEDICT NAME
while read -r code freedict name; do
  [[ -z $code || $code == \#* ]] && continue
  FREEDICT[$code]=$freedict
  NAME[$code]=$name
done <"$LIB/languages"

languages=(en es)
read -r -a languages 2>/dev/null <"${XDG_CONFIG_HOME:-$HOME/.config}/omarchy-dict/languages"

searched=("${languages[@]}")
selection=false
while [[ ${1:-} == --* ]]; do
  case $1 in
    --selection) selection=true ;;
    *)
      if [[ -z ${NAME[${1#--}]:-} ]]; then
        echo "define: unknown option $1" >&2
        exit 2
      fi
      searched=("${1#--}")
      ;;
  esac
  shift
done

# A language's databases, as "local remote" pairs: the local dictd server is
# used when it has the database, and dict.org when it doesn't. A "-" means
# there is no such database on that side. Translations go to every other
# installed language.
databases_for() {
  local other from=${FREEDICT[$1]} to

  if [[ $1 == en ]]; then
    printf '%s\n' "gcide gcide" "- wn" "- moby-thesaurus"
  else
    echo "$1-$1 -"
  fi
  for other in "${languages[@]}"; do
    to=${FREEDICT[$other]:-}
    [[ $other == "$1" || -z $to ]] || echo "$from-$to fd-$from-$to"
  done
}

# Print a database's definitions without dict's "N definitions found" banner.
query() {
  dict -h "$1" -d "$2" -- "$3" 2>/dev/null | sed '1{/definitions\? found$/{N;d}}'
  return "${PIPESTATUS[0]}"
}

search() {
  local local_db remote_db status=39
  read -r local_db remote_db <<<"$1"

  if [[ $local_db != - ]]; then
    query localhost "$local_db" "$2"
    status=$?
  fi

  # 0 is a match and 20/21 a miss; anything else means the local server or
  # database isn't there.
  if (( status != 0 && status != 20 && status != 21 )) && [[ $remote_db != - ]]; then
    query dict.org "$remote_db" "$2"
  fi
}

# Search every database of every searched language at once, then print the
# results in order, under a heading per language when more than one matched.
definitions() {
  local results code database file i=0 matched=()
  results=$(mktemp -d)

  # Number the files across languages, zero-padded so a glob keeps the order.
  for code in "${searched[@]}"; do
    mkdir "$results/$code"
    while read -r database; do
      printf -v file '%s/%s/%03d' "$results" "$code" "$i"
      i=$((i + 1))
      search "$database" "$1" >"$file" </dev/null &
    done < <(databases_for "$code")
  done
  wait

  for code in "${searched[@]}"; do
    for file in "$results/$code"/*; do
      [[ -s $file ]] && cat "$file" && echo
    done >"$results/$code.out"
    [[ -s $results/$code.out ]] && matched+=("$code")
  done

  for code in "${matched[@]}"; do
    if (( ${#matched[@]} > 1 )); then
      printf '%s\n%s\n\n' "${NAME[$code]}" "${NAME[$code]//?/═}"
    fi
    cat "$results/$code.out"
  done
  rm -r "$results"
}

# Show a word's definitions in less. Pass definitions already fetched as the
# second argument to skip searching again.
lookup() {
  local found=${2-} suggestions

  [[ -n $found ]] || found=$(definitions "$1")
  if [[ -z $found ]]; then
    found="No definitions found for \"$1\""
    if suggestions=$(dict -h localhost -m -s lev -- "$1" 2>/dev/null); then
      found+=$'\n\nPerhaps you mean:\n'"$suggestions"
    fi
  fi

  # The leading "s" picks less's short prompt, and the escapes keep prompt
  # syntax such as "?" and "." in the word literal.
  less "${pager[@]}" --prompt="s$(sed 's/[?%\\:.]/\\&/g' <<<"$1") (q to $leave)" <<<"$found"
}

# The primary selection's first line, without surrounding punctuation or space.
selected() {
  wl-paste --primary --no-newline 2>/dev/null | head -n1 |
    sed 's/^[^[:alnum:]]*//; s/[^[:alnum:]]*$//'
}

ask() {
  local prompt="Define: " placeholder="Word to define (Enter on empty to quit)"

  if command -v gum >/dev/null; then
    gum input --placeholder "$placeholder" --prompt "$prompt"
  else
    read -rp "$prompt" word && echo "$word"
  fi
}

if (( $# > 0 )); then
  pager=(--quit-if-one-screen)
  leave=quit
  lookup "$*"
  exit
fi

# Keep the pager open even for short entries, or the prompt's clear wipes them,
# and clear the screen so short entries are drawn from the top rather than
# scrolled up from the bottom, without "~" on the empty lines below them.
pager=(--clear-screen --tilde)
leave="go back"

if [[ $selection == true ]] && word=$(selected) && [[ -n $word ]]; then
  leave=close
  lookup "$word"
  exit
fi

while word=$(ask) && [[ -n $word ]]; do
  clear
  lookup "$word"
  clear
done
